<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:paddingStart="40dp" android:paddingEnd="40dp" android:paddingTop="24dp" android:paddingBottom="20dp"
    android:background="@drawable/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/brand" android:textSize="24sp" android:textColor="#F3F5FA" />
        <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#B5BECD" />
    </LinearLayout>
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="12dp" android:text="@string/your_apps" android:textSize="20sp" android:textColor="#F3F5FA" />
    <GridView android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:numColumns="4" android:horizontalSpacing="18dp" android:verticalSpacing="18dp" android:padding="8dp"
        android:clipToPadding="false" android:clipChildren="false" android:stretchMode="columnWidth"
        android:listSelector="@android:color/transparent" android:scrollbars="none" android:drawSelectorOnTop="false" />
    <TextView android:id="@+id/hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="12dp" android:text="@string/hint" android:textSize="13sp" android:textColor="#A6B0C0" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp">
        <TextView android:id="@+id/settings" style="@style/Footer" android:text="@string/settings" />
        <TextView android:id="@+id/inputs" style="@style/Footer" android:text="@string/inputs" />
        <TextView android:id="@+id/help" style="@style/Footer" android:text="@string/help" />
    </LinearLayout>
</LinearLayout>
