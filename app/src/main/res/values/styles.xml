<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/canvas_background</item>
        <item name="android:colorAccent">@color/text_primary</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>
    <style name="HeaderButton">
        <item name="android:layout_width">@dimen/header_button</item>
        <item name="android:layout_height">@dimen/header_button</item>
        <item name="android:padding">11dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/header_button</item>
        <item name="android:tint">@color/on_focus_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
