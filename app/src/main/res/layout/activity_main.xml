<!-- Home: one scrolling surface (Top Shelf region + unified app grid) under an overlay layer.
     Shelf height, safe-area padding and tile sizes are applied in code from HomeLayout. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/background">
    <tv.still.launcher.CalmScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scrollbars="none" android:overScrollMode="never" android:fillViewport="true"
        android:descendantFocusability="afterDescendants" android:clipChildren="false">
        <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false">
            <FrameLayout android:id="@+id/shelf" android:layout_width="match_parent" android:layout_height="270dp"
                android:clipChildren="false">
                <View android:id="@+id/shelf_backdrop" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
                <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="@dimen/header_button"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/wordmark" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/brand" android:contentDescription="@string/brand_description"
                        android:textSize="@dimen/text_label" android:textColor="@color/text_secondary" android:letterSpacing="0.08" />
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_2" android:textSize="@dimen/text_heading"
                        android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium" />
                    <ImageView android:id="@+id/search_button" style="@style/HeaderButton"
                        android:src="@drawable/ic_search" android:contentDescription="@string/search" />
                    <ImageView android:id="@+id/controls_button" style="@style/HeaderButton" android:layout_marginStart="@dimen/space_1"
                        android:src="@drawable/ic_controls" android:contentDescription="@string/controls" />
                </LinearLayout>
                <LinearLayout android:id="@+id/hero" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="bottom" android:orientation="vertical" android:importantForAccessibility="no">
                    <!-- Fixed heights so changing the text never relayouts the screen. -->
                    <TextView android:id="@+id/hero_title" android:layout_width="match_parent" android:layout_height="56dp"
                        android:gravity="bottom" android:textSize="@dimen/text_hero" android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/hero_subtitle" android:layout_width="match_parent" android:layout_height="26dp"
                        android:gravity="center_vertical" android:textSize="@dimen/text_body" android:textColor="@color/text_secondary"
                        android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>
            </FrameLayout>
            <LinearLayout android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" />
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_2" android:textSize="@dimen/text_body" android:textColor="@color/text_secondary"
                android:visibility="gone" />
        </LinearLayout>
    </tv.still.launcher.CalmScrollView>
    <!-- Edit mode instructions; visible only while an app is picked up, wherever the grid is scrolled. -->
    <TextView android:id="@+id/edit_hint" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="@dimen/space_4"
        android:paddingStart="@dimen/space_3" android:paddingEnd="@dimen/space_3" android:paddingTop="10dp" android:paddingBottom="10dp"
        android:background="@drawable/panel" android:text="@string/moving_hint" android:textSize="@dimen/text_body"
        android:textColor="@color/text_primary" android:visibility="gone" android:accessibilityLiveRegion="polite" />
    <FrameLayout android:id="@+id/overlays" android:layout_width="match_parent" android:layout_height="match_parent" />
</FrameLayout>
