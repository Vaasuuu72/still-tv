<!-- Safe-area side and top margins are applied in code from HomeLayout (5% of the screen). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/background" android:clipChildren="false">
    <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="56dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/brand" android:contentDescription="@string/brand_description"
            android:textSize="24sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="20sp" android:textColor="@color/text_secondary" android:fontFamily="sans-serif" />
        <TextView android:id="@+id/inputs" style="@style/Pill" android:layout_marginStart="28dp" android:text="@string/inputs" />
        <TextView android:id="@+id/settings" style="@style/Pill" android:layout_marginStart="12dp" android:text="@string/settings" />
    </LinearLayout>
    <tv.still.launcher.CalmScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scrollbars="none" android:overScrollMode="never" android:fillViewport="true"
        android:descendantFocusability="afterDescendants">
        <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false"
            android:paddingTop="20dp" android:paddingBottom="48dp">
            <LinearLayout android:id="@+id/dock" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" />
            <LinearLayout android:id="@+id/caption" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:layout_marginBottom="16dp" android:gravity="bottom">
                <TextView android:id="@+id/section_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/all_apps" android:textSize="18sp" android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/hint" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/hint" android:textSize="14sp" android:textColor="@color/text_secondary" android:letterSpacing="0.01" />
            </LinearLayout>
            <LinearLayout android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" />
        </LinearLayout>
    </tv.still.launcher.CalmScrollView>
</LinearLayout>
