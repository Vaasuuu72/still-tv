<!-- One Home item (app or folder). Card size is set in code from HomeLayout. Only transforms and alpha animate. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
    android:clipChildren="false" android:clipToPadding="false" android:focusable="true" android:focusableInTouchMode="false"
    android:clickable="true" android:longClickable="true" android:importantForAccessibility="yes">
    <FrameLayout android:id="@+id/frame" android:layout_width="129dp" android:layout_height="77dp"
        android:clipChildren="false" android:clipToPadding="false">
        <View android:id="@+id/shadow" android:layout_width="match_parent" android:layout_height="match_parent"
            android:layout_marginStart="-8dp" android:layout_marginEnd="-8dp" android:layout_marginTop="-2dp" android:layout_marginBottom="-14dp"
            android:background="@drawable/card_shadow" android:alpha="0" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/art" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitXY" android:importantForAccessibility="no" />
        <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom" android:layout_marginBottom="6dp" android:paddingStart="8dp" android:paddingEnd="8dp"
            android:gravity="center" android:textSize="12sp" android:textColor="@color/text_primary" android:maxLines="1"
            android:ellipsize="end" android:visibility="gone" android:importantForAccessibility="no" />
        <View android:id="@+id/glow" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/card_glow" android:alpha="0" android:importantForAccessibility="no" />
    </FrameLayout>
    <TextView android:id="@+id/label" android:layout_width="129dp" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:gravity="center" android:textSize="@dimen/text_label" android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:alpha="0"
        android:importantForAccessibility="no" />
</LinearLayout>
